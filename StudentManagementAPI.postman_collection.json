{
  "info": {
    "name": "Student Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register Student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\",\n  \"major\": \"Computer Science\",\n  \"age\": 22\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/students/register",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "students", "register"]
        }
      }
    },
    {
      "name": "Login Student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/students/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "students", "login"]
        }
      }
    },
    {
      "name": "Get Student",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:8080/api/students/{{studentId}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "students", "{{studentId}}"]
        }
      }
    },
    {
      "name": "Process Payment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"studentId\": \"student-uuid-here\",\n  \"amount\": 500.00,\n  \"paymentMethod\": \"credit_card\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/students/payment",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "students", "payment"]
        }
      }
    },
    {
      "name": "Logout Student",
      "request": {
        "method": "POST",
        "url": {
          "raw": "http://localhost:8080/api/students/logout/{{studentId}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "students", "logout", "{{studentId}}"]
        }
      }
    }
  ]
}
